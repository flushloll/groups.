# Copy this file to .env.local. Values stay on the Node server; never use VITE_ names for secrets.

# --- Luna's model connection -------------------------------------------------
# Direct OpenAI (Responses API).
GROUPS_AI_PROVIDER=openai
OPENAI_API_KEY=
GROUPS_AI_MODEL=gpt-6-luna

# Vercel AI Gateway: GROUPS_AI_PROVIDER=gateway, GROUPS_AI_MODEL=openai/gpt-6-luna
AI_GATEWAY_API_KEY=

# OpenAI-compatible endpoint (LM Studio, Ollama, vLLM...): GROUPS_AI_PROVIDER=compatible
# From inside a container, reach a model server on the host with http://host.docker.internal:1234/v1
GROUPS_AI_BASE_URL=
GROUPS_AI_API_KEY=
# Set false if the model cannot accept image inputs.
GROUPS_AI_IMAGES=true
# Quiet time (ms) before Luna considers ordinary conversation. Direct requests are immediate.
# GROUPS_LUNA_QUIET_MS=4500

# --- Optional server transcription -------------------------------------------
# For browsers without built-in speech recognition (e.g. Firefox). Billed per audio minute.
# GROUPS_TRANSCRIPTION=openai
# GROUPS_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# GROUPS_TRANSCRIPTION_API_KEY=        # defaults to OPENAI_API_KEY
# GROUPS_TRANSCRIPTION_BASE_URL=       # defaults to https://api.openai.com/v1

# --- Voice networking ----------------------------------------------------------
# JSON array of RTCIceServer objects. Add a TURN server for restrictive networks.
# GROUPS_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# --- External assistants over MCP ------------------------------------------------
# Random secret of at least 32 characters. Administrative: keep it off untrusted clients.
GROUPS_MCP_TOKEN=

# --- Hosting -----------------------------------------------------------------------
# Postgres instead of local SQLite (required where the disk is temporary, e.g. Render free).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# A signing secret is generated in .groups-data/auth-secret when unset.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://groups.example.com
# GROUPS_ORIGINS=https://groups.example.com
# GROUPS_DATA_DIR=/var/lib/groups
# Use forwarded client IPs for rate limiting when behind a proxy (Vercel, Fly).
# GROUPS_TRUST_PROXY=true
# PORT=3001
