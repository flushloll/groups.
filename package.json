{
  "name": "groups",
  "version": "1.0.0",
  "private": true,
  "description": "A shared 3D world where people talk together and an AI builds what they describe.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "ai": "^7.0.143",
    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^24.10.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
